MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@opencode:example.org
MATRIX_PASSWORD=replace-this-for-the-first-login-only

# Persistent Matrix keys, login, and room mappings are stored here.
MATRIX_DATA_DIR=./data

# Both comma-separated allowlists are required.
MATRIX_ALLOWED_ROOMS=!roomid:example.org
MATRIX_ALLOWED_SENDERS=@your-user:example.org
MATRIX_AUTO_JOIN=false
MATRIX_REQUIRE_ENCRYPTION=true

# Show provider-exposed OpenCode thinking text in the live Matrix message.
# This may include sensitive workspace context; leave disabled in shared rooms.
MATRIX_SHOW_REASONING=false

# false refuses to send to unverified devices. See README before changing this.
MATRIX_IGNORE_UNVERIFIED_DEVICES=false

# OpenCode connection and run.sh server settings.
OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_BIN=/custom/path/to/opencode
OPENCODE_SERVER_HOSTNAME=127.0.0.1
OPENCODE_SERVER_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-separate-strong-password

# Abort and automatically continue an in-flight turn after this many seconds
# without OpenCode activity. Must be a positive integer.
OPENCODE_STUCK_TIMEOUT_SECONDS=900

# Pursuits recover more aggressively: a silent pursuit turn is quarantined after
# 3 minutes, and an individually running tool after 2 minutes.
OPENCODE_PURSUE_STUCK_TIMEOUT_SECONDS=180
OPENCODE_PURSUE_TOOL_TIMEOUT_SECONDS=120

# Start the next pursuit pass in a fresh worker after the current worker has
# accumulated this many input tokens. The goal and verified evidence are retained.
OPENCODE_PURSUE_CONTEXT_INPUT_TOKENS=250000

# Coalesce live Matrix progress edits to avoid homeserver HTTP 429 rate limits.
# Final answers, permission prompts, and command replies are not delayed by this.
MATRIX_EDIT_INTERVAL_SECONDS=5

# !new without an argument uses this directory. Relative paths are based here.
OPENCODE_DEFAULT_DIRECTORY=/absolute/path/to/projects

# Existing allowed roots, separated by ':' on Linux/macOS.
OPENCODE_ALLOWED_ROOTS=/absolute/path/to/projects:/absolute/path/to/other-work
