MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@eliza:example.org
MATRIX_PASSWORD=replace-this-for-the-first-login-only

# Persistent encryption keys and the login session are stored here.
ELIZA_DATA_DIR=./data

# Optional. If omitted, the bot generates its own ELIZA picture.
# ELIZA_PICTURE=./my-eliza.png

# Strongly recommended: comma-separated room IDs the bot is allowed to use.
MATRIX_ALLOWED_ROOMS=!roomid:example.org
MATRIX_AUTO_JOIN=false
MATRIX_REQUIRE_ENCRYPTION=true

# false refuses to send to unverified devices. See README before changing this.
MATRIX_IGNORE_UNVERIFIED_DEVICES=false

